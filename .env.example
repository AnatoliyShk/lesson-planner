# Copy to .env and adjust. Read by Docker Compose for variable substitution
# in compose.yml. Not read by CakePHP -- the app's own dotenv file is
# config/.env (see config/bootstrap.php).

# Host port the app is published on.
APP_PORT=8765

# Database. MYSQL_PASSWORD and MYSQL_ROOT_PASSWORD are required; compose
# refuses to start without them.
MYSQL_VERSION=8.4
MYSQL_PORT=3308
MYSQL_DATABASE=cake
MYSQL_USER=cake
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
